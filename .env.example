# Port for Web Dashboard
PORT=3000

# Authentication folder path (used on Render persistent disk e.g. /opt/render/project/src/auth_info)
AUTH_DIR=auth_info

# Name of the phone/bot owner for AI system prompt context
ASSISTANT_OWNER_NAME=Alex

# AI Provider Selection ("auto", "anthropic", "openai", "gemini")
AI_PROVIDER=auto

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Filter Settings
IGNORE_NUMBERS=
REPLY_IN_GROUPS=false
WHITELIST_MODE=false
ALLOWED_NUMBERS=

# Human-like typing delay range before sending reply (in milliseconds)
REPLY_DELAY_MIN_MS=2000
REPLY_DELAY_MAX_MS=5000
