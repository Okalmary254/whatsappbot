# Web dashboard port
PORT=3000

# WhatsApp session directory; use persistent storage when deploying
AUTH_DIR=auth_info

# Name used in the assistant's system prompt
ASSISTANT_OWNER_NAME=Jean

# Groq API (create a key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Contact filtering
IGNORE_NUMBERS=
REPLY_IN_GROUPS=false
WHITELIST_MODE=false
ALLOWED_NUMBERS=

# Reply delay range in milliseconds
REPLY_DELAY_MIN_MS=2000
REPLY_DELAY_MAX_MS=5000
