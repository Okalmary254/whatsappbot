# Web dashboard port and bind address
PORT=3000
HOST=127.0.0.1

# Required when HOST=0.0.0.0 or exposing the dashboard remotely
DASHBOARD_PASSWORD=

# Persistent directory: set to the mounted disk path on hosting platforms (required for linked sessions)
DATA_DIR=

# Set true only to run the legacy single-account bot alongside the multi-user portal
ENABLE_LEGACY_BOT=false

# Name used in the assistant's system prompt
ASSISTANT_OWNER_NAME=Jean

# Groq API (create a key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Contact filtering
IGNORE_NUMBERS=
REPLY_IN_GROUPS=false
WHITELIST_MODE=false
ALLOWED_NUMBERS=

# Rate limiting and retention
SENDER_COOLDOWN_MS=5000
MESSAGE_RETENTION_DAYS=30
MAX_MESSAGES_PER_CHAT=500

# Reply delay range in milliseconds
REPLY_DELAY_MIN_MS=2000
REPLY_DELAY_MAX_MS=5000
